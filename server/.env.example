# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交真实值）
# Copy to .env and fill in (never commit the real value)

# 写令牌：可写库 / 上传产物 / 拉源码快照（含 MFi）。多个用英文逗号分隔（支持轮换）
# Write token: write KB / upload artifacts / pull source snapshot (contains MFi). Comma-separated.
KB_TOKEN=replace-me-with-a-long-random-string

# 只读令牌：仅查询/推荐/拉规则，随 Skill 对外分发也安全。留空则不启用只读访问
# Read-only token: query/recommend/spec only. Safe to ship with the Skill. Empty = disabled.
KB_RO_TOKEN=

# 产物存储目录（APK 分发：上传需写令牌，下载走 /a/<sha256>.apk 免令牌）
ART_DIR=/opt/estrella-kb/artifacts
ART_MAX_MB=200

# 知识库数据目录（kb.json / audit.log.jsonl / backups 都在这里）
KB_DIR=/opt/estrella-kb/data

# 源码快照路径（/kb/source 提供下载；服务器只存不编译）
SRC_FILE=/opt/estrella-kb/diplay-src/diplay-src.tar.gz

# 服务端口 / 限频（每 IP 每分钟）
PORT=7799
RATE_LIMIT=120
