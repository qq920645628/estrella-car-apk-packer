# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交真实值）
# Copy to .env and fill in (never commit the real value)

# 鉴权令牌，多个用英文逗号分隔（支持轮换）
# Auth token(s), comma-separated for rotation
KB_TOKEN=replace-me-with-a-long-random-string

# 知识库数据目录（kb.json / audit.log.jsonl / backups 都在这里）
KB_DIR=/opt/estrella-kb/data

# 源码快照路径（/kb/source 提供下载；服务器只存不编译）
SRC_FILE=/opt/estrella-kb/diplay-src/diplay-src.tar.gz

# 服务端口 / 限频（每 IP 每分钟）
PORT=7799
RATE_LIMIT=120
